ANTHROPIC_API_KEY=
DATABASE_URL=

# CLI only (`npm run dev`). WA path resolves users by phone via the users table.
DONNA_USER_ID=

# whatsapp (only required for `npm run wa`)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=aura-verify-token
WHATSAPP_GRAPH_VERSION=v19.0
PORT=3000

# langsmith observability (optional — leave LANGSMITH_TRACING unset to disable)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=donna

# composio (required for the inbox copilot — gmail tools wrap composio actions)
# COMPOSIO_USER_ID is the entity id you connected gmail under.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# world engine — donna actively looks at the world via exa.
# EXA_API_KEY: required for the world engine.
# SUPERMEMORY_API_KEY: required for context auto-build (else profile_blurb is empty).
# WORLD_PER_TURN / WORLD_PER_DAY: optional caps (defaults 1 / 3).
# WORLD_TICK_INTERVAL_MINUTES: cadence for self-rescheduling (default 240).
EXA_API_KEY=
SUPERMEMORY_API_KEY=
WORLD_PER_TURN=
WORLD_PER_DAY=
WORLD_TICK_INTERVAL_MINUTES=

# linq partner api — iMessage / RCS / SMS
# LINQ_API_KEY: bearer token from your linq representative
# LINQ_FROM_NUMBER: phone provisioned on your linq account, E.164 (e.g. +12025551234)
# LINQ_WEBHOOK_SECRET: signing_secret returned by POST /webhook-subscriptions
#   (run `npm run setup:imessage -- https://your-host/imessage/webhook` once)
# LINQ_BASE_URL: optional, defaults to https://api.linqapp.com/api/partner/v3
LINQ_API_KEY=
LINQ_FROM_NUMBER=
LINQ_WEBHOOK_SECRET=
LINQ_BASE_URL=

# calorie tracker
# NUTRITIONIX_*: developer.nutritionix.com — free tier covers personal volume
# OPENAI_API_KEY: whisper-1 transcription for voice notes
# SUPABASE_*: storage uploads for meal photos and weekly chart pngs
# SUPABASE_STORAGE_BUCKET_*: bucket names (defaults shown)
# CALORIE_QUIET_HOURS: window where proactive nudges are suppressed
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_MEDIA=meal_media
SUPABASE_STORAGE_BUCKET_CHARTS=meal_charts
CALORIE_QUIET_HOURS=00:00-07:00
