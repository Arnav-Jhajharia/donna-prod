# donna env — only vars actually read by src/.
# copy to .env and fill in. never commit a real .env.

# required: anthropic api key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# postgres connection. supabase → settings → database → transaction pooler
# (port 6543, NOT direct 5432). url-encode any special chars in the password.
DATABASE_URL=

# clerk — backend jwt verification + admin api for writing user metadata
# https://dashboard.clerk.com → api keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# whatsapp business api (meta direct). webhook verify token is whatever
# you set in the meta dashboard; the phone number id and access token come
# from the whatsapp setup page.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# the e.164 number users text the pairing code to. shown to the mobile app
# during onboarding so the user knows where to message.
DONNA_WHATSAPP_NUMBER=

# optional: port for the hono server (defaults to 3000)
# PORT=3000

# voice surface (voice/agent.ts) — required for `npm run voice`.
# livekit cloud project: https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# speech to text: https://deepgram.com
DEEPGRAM_API_KEY=

# text to speech provider. one of: cartesia (default), elevenlabs, sesame.
# only the keys for the selected provider need to be filled in.
VOICE_TTS_PROVIDER=cartesia

# cartesia sonic-3 via wss. ~100ms TTFB. browse voices at
# https://play.cartesia.ai/voices to pick a CARTESIA_VOICE_ID.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# elevenlabs flash v2.5. ~75ms TTFB. picks a voice from your elevenlabs
# library: https://elevenlabs.io/app/voice-lab
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# sesame CSM-1B on modal. set to the wss:// url printed by
# `modal deploy voice/csm/modal_server.py`, with /tts appended.
# e.g. wss://yourorg--donna-csm-csmserver-fastapi-app.modal.run/tts
SESAME_WS_URL=

# apple push notification service — only needed for /call/start (voip push
# that rings the user's phone via CallKit). path-A flow (/call/token) works
# without these.
#
# get the .p12 from apple developer → certificates → "voip services
# certificate" tied to your real bundle id. store the file somewhere local
# (not committed) and point APNS_VOIP_CERT_PATH at it.
APNS_VOIP_CERT_PATH=
APNS_VOIP_CERT_PASSPHRASE=
APNS_BUNDLE_ID=
# "true" once you're on testflight/production. dev builds use sandbox apns.
APNS_PRODUCTION=false

# ─── compliance / data lifecycle ───────────────────────────────────────────

# master key for src/donna/crypto.ts. encrypts every third-party token (oauth
# refresh tokens, imap app passwords, etc.) before they hit the db.
# generate with: openssl rand -hex 32
DONNA_ENCRYPTION_KEY=

# where the brain's jsonl ledger writes (one file per day). defaults to
# .donna/ledger when unset.
# DONNA_LEDGER_DIR=.donna/ledger

# root of the donna-browser per-user chromium profiles. only set on the api
# server if the donna-browser ebs is mounted here (it usually isn't —
# account-delete cleanup is a no-op when the dir doesn't exist).
# DONNA_BROWSER_DATA_DIR=/data/users
