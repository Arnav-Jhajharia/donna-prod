ANTHROPIC_API_KEY=
DATABASE_URL=

# CLI only (`npm run dev`). WA path resolves users by phone via the users table.
DONNA_USER_ID=

# whatsapp (only required for `npm run wa`)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=aura-verify-token
WHATSAPP_GRAPH_VERSION=v19.0
PORT=3000

# langsmith observability (optional — leave LANGSMITH_TRACING unset to disable)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=donna

# composio (required for the inbox copilot — gmail tools wrap composio actions)
# COMPOSIO_USER_ID is the entity id you connected gmail under.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# linq partner api — iMessage / RCS / SMS
# LINQ_API_KEY: bearer token from your linq representative
# LINQ_FROM_NUMBER: phone provisioned on your linq account, E.164 (e.g. +12025551234)
# LINQ_WEBHOOK_SECRET: signing_secret returned by POST /webhook-subscriptions
#   (run `npm run setup:imessage -- https://your-host/imessage/webhook` once)
# LINQ_BASE_URL: optional, defaults to https://api.linqapp.com/api/partner/v3
LINQ_API_KEY=
LINQ_FROM_NUMBER=
LINQ_WEBHOOK_SECRET=
LINQ_BASE_URL=
