{
  "expo": {
    "name": "donna",
    "slug": "donna-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "donna",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-dev-client"
    ],
    "ios": {
      "bundleIdentifier": "com.donna.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "voip",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.donna.app"
    }
  }
}
