{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*", "voice/**/*"],
  "exclude": [
    "src/_archive/**",
    "src/donna/_archive/**",
    "scripts/_archive/**",
    "supabase/_archive/**"
  ]
}
